# =============================================================================
# CyberStock Pulse — environment variables template
# -----------------------------------------------------------------------------
# This file lists variable NAMES only. Never put real secrets here.
# Real values live in `.env`, encrypted with dotenvx:
#   ./scripts/secrets.sh init                     # create encrypted .env from this template
#   ./scripts/secrets.sh set DEEPSEEK_API_KEY     # prompts for the value (not echoed)
# The private decryption key is written to `.env.keys` (git-ignored, never commit it).
# =============================================================================

# ---- Database (PostgreSQL + TimescaleDB) ----
POSTGRES_DB=cyberstock
POSTGRES_USER=cyberstock
# Required. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Backend (Spring Boot) ----
# Required. HMAC secret for JWT signing (≥ 32 bytes), shared with analytics-ai.
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=120
# Comma-separated allowed browser origins (web + Capacitor iOS/Android shells)
CORS_ALLOWED_ORIGINS=https://localhost:60003,https://stock.jackstudio.app,http://localhost:5173,capacitor://localhost,https://localhost
# Market data: yahoo (real prices, no API key, unofficial endpoint, personal use only;
#   HK quotes ~15 min delayed) | mock (simulated) | finnhub (needs FINNHUB_API_KEY; free plan = US only)
MARKET_DATA_PROVIDER=yahoo
# Seconds between polls; one request per symbol each time (13 symbols / 15 s ≈ 52 req/min)
YAHOO_POLL_SECONDS=15
FINNHUB_API_KEY=
FINNHUB_POLL_SECONDS=15

# ---- Analytics AI (FastAPI) ----
# DeepSeek is the preferred provider for all LLM analysis
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model for news sentiment / summaries
DEEPSEEK_MODEL_FAST=deepseek-chat
# Model for the AI analyst chat (must support tool calling)
DEEPSEEK_MODEL_CHAT=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional OpenAI-compatible fallback, used only when DeepSeek fails. Leave empty to disable.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# News: yahoo (real headlines via Yahoo Finance RSS, no API key, personal use only)
#   | mock (synthetic headlines) | finnhub (needs FINNHUB_API_KEY)
# Each NEW article costs one DeepSeek call when DEEPSEEK_API_KEY is set (stored articles are never re-analysed)
NEWS_PROVIDER=yahoo
NEWS_POLL_SECONDS=60

# ---- Web ----
WEB_PORT=60003
# Public domain served by the shared Caddy (~/github/hobbyland)
DOMAIN=stock.jackstudio.app
IMAGE_TAG=latest
